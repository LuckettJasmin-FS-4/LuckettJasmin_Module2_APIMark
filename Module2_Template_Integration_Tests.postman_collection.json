    {
      "name": "POST Create Template",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Created template has correct name\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql(\"Integration Test Template\");",
              "});",
              "",
              "pm.test(\"Created template has an ID\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"_id\");",
              "",
              "    pm.collectionVariables.set(\"templateId\", jsonData._id);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
